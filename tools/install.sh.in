#!/usr/bin/env bash
# =============================================================================
#  realhax-desktop  —  transform a Linux machine into the "realhax Linux" desktop
#
#  XFCE 4.18 + Orchis(red, black) GTK/xfwm4 theme renamed "RealHax-Dark",
#  "RealHax" icon theme (Papirus-Dark + red folders), neon ring wallpaper,
#  top panel (whisker "Applications" menu, tray, clock, power), plank dock,
#  conky "System" + "Lab Info" widgets, alacritty + fish/starship prompt,
#  fastfetch/neofetch branding.
#
#  One-shot:  curl -fsSL https://raw.githubusercontent.com/R3dy/realhax-desktop/main/install.sh | bash
#  Usage:     bash install.sh [options]   (or: curl ... | bash -s -- [options])
#    --skip-packages   don't touch system packages (no sudo)
#    --no-apps         don't install dock apps (VS Code, Wireshark)
#    --keep-session    don't make XFCE the default login session
#    --lab-persona     fastfetch card shows student@realhax / Host: Training VM
#                      (cosmetic only; real user and hostname are unchanged)
#    --restore         undo: restore every file this script replaced
#    -h | --help
#
#  Supported package managers: apt, dnf, pacman, zypper.
#  Every downloaded artifact is pinned to a version and sha256-verified.
#  Run it as your normal user (it calls sudo itself). Safe to re-run.
#
#  This file is GENERATED by tools/build.sh from tools/install.sh.in —
#  edit that, then rebuild.
# =============================================================================
set -euo pipefail

RH_VERSION="1.0.0"
ORCHIS_TAG="2025-04-25"
ORCHIS_SHA256="d479653415e271fe9f3324f1f4f51cf28b1134164667142c6c6a6db41cf4da9b"
NERDFONT_VER="v3.4.0"
NERDFONT_SHA256="ef552a3e638f25125c6ad4c51176a6adcdce295ab1d2ffacf0db060caf8c1582"
FASTFETCH_VER="2.40.4"
FASTFETCH_SHA256_amd64="e559c05f8d93dc5678800af7c4e806aa0fb7af2ce246ce84dfb16ef26a4174a5"
FASTFETCH_SHA256_aarch64="094a24472cf42fd44bab4389c98cfb09b83ca98fa37bbbb4b85277a7cdd6f4c9"
WALLPAPER_URL="https://raw.githubusercontent.com/R3dy/realhax-desktop/main/assets/wallpaper.png"
WALLPAPER_SHA256="ea2a165b9b5e00b0a4513c1f04e46d83636037421349c799a73da9b2c61f3e0f"

# palette
RED="#ff2340"; BG="#0b0c10"; FG="#d6d9df"; BLUE="#1f4fa8"

SKIP_PKGS=0; NO_APPS=0; KEEP_SESSION=0; RESTORE=0; LAB_PERSONA=0
for a in "$@"; do
  case "$a" in
    --skip-packages) SKIP_PKGS=1 ;;
    --no-apps) NO_APPS=1 ;;
    --keep-session) KEEP_SESSION=1 ;;
    --restore) RESTORE=1 ;;
    --lab-persona) LAB_PERSONA=1 ;;
    -h|--help) printf '%s\n' "realhax-desktop $RH_VERSION" "" \
        "Usage: bash install.sh [options]" \
        "  --skip-packages   don't touch system packages (no sudo)" \
        "  --no-apps         don't install dock apps (VS Code, Wireshark)" \
        "  --keep-session    don't make XFCE the default login session" \
        "  --lab-persona     fastfetch card shows student@realhax / Host: Training VM" \
        "                    (cosmetic only; real user and hostname are unchanged)" \
        "  --restore         undo: restore every file this script replaced"; exit 0 ;;
    *) echo "unknown option: $a" >&2; exit 2 ;;
  esac
done

[[ $EUID -eq 0 ]] && { echo "Run as your normal user, not root (sudo is used where needed)." >&2; exit 1; }

C="${XDG_CONFIG_HOME:-$HOME/.config}"
D="${XDG_DATA_HOME:-$HOME/.local/share}"
RH="$D/realhax"                    # assets + state
MANIFEST="$RH/manifest.txt"        # every file we manage
BACKUP="$RH/backup"                # originals (captured once, first time we touch a file)
mkdir -p "$RH" "$BACKUP"; touch "$MANIFEST"

log()  { printf '\033[1;31m[realhax]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[realhax] WARN:\033[0m %s\n' "$*" >&2; }

# --------------------------------------------------------------------------- restore
if (( RESTORE )); then
  log "Restoring originals from $BACKUP"
  pkill -u "$USER" -x xfconfd 2>/dev/null || true
  while IFS= read -r f; do
    [[ -z $f ]] && continue
    rel="${f#/}"
    if [[ -e "$BACKUP/$rel" || -L "$BACKUP/$rel" ]]; then
      if [[ $f == "$HOME"/* ]]; then cp -a "$BACKUP/$rel" "$f"; else sudo cp -a "$BACKUP/$rel" "$f"; fi
      log "restored $f"
    else
      if [[ $f == "$HOME"/* ]]; then rm -rf "$f"; else sudo rm -rf "$f"; fi
      log "removed  $f"
    fi
  done < <(sort -ru "$MANIFEST")
  : > "$MANIFEST"
  log "Done. Packages were left installed. Log out and back in."
  exit 0
fi

# put <dest> : write stdin to dest, backing up the original the first time.
put() {
  local dest=$1 rel="${1#/}" sudo=""
  [[ $dest == "$HOME"/* ]] || sudo="sudo"
  if ! grep -qxF "$dest" "$MANIFEST"; then
    if [[ -e $dest || -L $dest ]]; then
      mkdir -p "$BACKUP/$(dirname "$rel")"
      $sudo cp -a "$dest" "$BACKUP/$rel"
    fi
    echo "$dest" >> "$MANIFEST"
  fi
  $sudo mkdir -p "$(dirname "$dest")"
  if [[ -n $sudo ]]; then sudo tee "$dest" >/dev/null; else cat > "$dest"; fi
}
# track a directory we create wholesale (removed on restore)
track() { grep -qxF "$1" "$MANIFEST" || { [[ -e $1 ]] && { mkdir -p "$BACKUP/$(dirname "${1#/}")"; cp -a "$1" "$BACKUP/${1#/}"; }; echo "$1" >> "$MANIFEST"; }; }

fetch() { # fetch <url> <sha256> <out>
  curl -fsSL --retry 3 -o "$3" "$1"
  echo "$2  $3" | sha256sum -c --quiet - || { echo "checksum mismatch for $1" >&2; exit 1; }
}
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT

# --------------------------------------------------------------------------- 1. packages
pm=""
for p in apt-get dnf pacman zypper; do command -v $p >/dev/null && { pm=$p; break; }; done

pkgs_for() {
  case "$pm" in
    apt-get) echo "xfce4 xfce4-whiskermenu-plugin xfce4-pulseaudio-plugin xfce4-notifyd xfce4-appfinder
      thunar mousepad plank conky-all papirus-icon-theme fonts-inter fonts-dejavu-core alacritty fish
      librsvg2-bin sassc gtk2-engines-murrine curl git xz-utils x11-xserver-utils dconf-cli iproute2
      libglib2.0-bin xdg-user-dirs network-manager-gnome" ;;
    dnf) echo "xfce4-session xfwm4 xfdesktop xfce4-panel xfce4-settings xfconf Thunar mousepad xfce4-appfinder
      xfce4-whiskermenu-plugin xfce4-pulseaudio-plugin xfce4-notifyd plank conky papirus-icon-theme
      rsms-inter-fonts dejavu-sans-mono-fonts alacritty fish librsvg2-tools sassc gtk-murrine-engine curl git xz
      xrandr dconf iproute glib2 xdg-user-dirs network-manager-applet" ;;
    pacman) echo "xfce4 xfce4-whiskermenu-plugin xfce4-pulseaudio-plugin xfce4-notifyd plank conky
      papirus-icon-theme inter-font ttf-dejavu alacritty fish librsvg sassc gtk-engine-murrine curl git xz
      xorg-xrandr dconf iproute2 glib2 xdg-user-dirs network-manager-applet" ;;
    zypper) echo "patterns-xfce-xfce xfce4-whiskermenu-plugin xfce4-pulseaudio-plugin xfce4-notifyd plank conky
      papirus-icon-theme google-inter-fonts dejavu-fonts alacritty fish rsvg-convert sassc gtk2-engine-murrine
      curl git xz xrandr dconf iproute2 glib2-tools xdg-user-dirs NetworkManager-applet" ;;
  esac
}
app_pkgs_for() {
  case "$pm" in
    apt-get) echo "wireshark code" ;; dnf) echo "wireshark code" ;;
    pacman) echo "wireshark-qt code" ;; zypper) echo "wireshark-ui-qt code" ;;
  esac
}
pkg_available() {
  case "$pm" in
    apt-get) apt-cache show "$1" >/dev/null 2>&1 ;;
    dnf) dnf -q info "$1" >/dev/null 2>&1 ;;
    pacman) pacman -Si "$1" >/dev/null 2>&1 || pacman -Sg "$1" >/dev/null 2>&1 ;;
    zypper) zypper -q info "$1" 2>/dev/null | grep -q '^Name' ;;
  esac
}
add_vscode_repo() {
  case "$pm" in
    apt-get)
      [[ -f /etc/apt/sources.list.d/vscode.list ]] && return
      curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor > "$TMP/ms.gpg"
      sudo install -Dm644 "$TMP/ms.gpg" /usr/share/keyrings/microsoft.gpg
      echo "deb [arch=amd64,arm64,armhf signed-by=/usr/share/keyrings/microsoft.gpg] https://packages.microsoft.com/repos/code stable main" \
        | sudo tee /etc/apt/sources.list.d/vscode.list >/dev/null
      echo "wireshark-common wireshark-common/install-setuid boolean false" | sudo debconf-set-selections ;;
    dnf|zypper)
      [[ -f /etc/yum.repos.d/vscode.repo || -f /etc/zypp/repos.d/vscode.repo ]] && return
      sudo rpm --import https://packages.microsoft.com/keys/microsoft.asc
      local f=/etc/yum.repos.d/vscode.repo; [[ $pm == zypper ]] && f=/etc/zypp/repos.d/vscode.repo
      printf '[code]\nname=Visual Studio Code\nbaseurl=https://packages.microsoft.com/yumrepos/vscode\nenabled=1\ngpgcheck=1\ngpgkey=https://packages.microsoft.com/keys/microsoft.asc\n' \
        | sudo tee "$f" >/dev/null ;;
  esac
}

if (( ! SKIP_PKGS )); then
  [[ -z $pm ]] && { echo "No supported package manager found (apt/dnf/pacman/zypper). Use --skip-packages." >&2; exit 1; }
  log "Installing packages with $pm (sudo)…"
  sudo -v
  want=$(pkgs_for)
  if (( ! NO_APPS )); then add_vscode_repo; want="$want $(app_pkgs_for)"; fi
  case "$pm" in
    apt-get) sudo apt-get update -qq ;; dnf) sudo dnf -q makecache ;;
    pacman) sudo pacman -Sy --noconfirm >/dev/null ;; zypper) sudo zypper -q refresh ;;
  esac
  avail=(); missing=()
  for p in $want; do if pkg_available "$p"; then avail+=("$p"); else missing+=("$p"); fi; done
  (( ${#missing[@]} )) && warn "not in your repos, skipped: ${missing[*]}"
  case "$pm" in
    # --no-install-recommends: keep the current display manager (don't pull lightdm)
    apt-get) sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends "${avail[@]}" ;;
    dnf) sudo dnf install -y -q "${avail[@]}" ;;
    pacman) sudo pacman -S --needed --noconfirm "${avail[@]}" ;;
    zypper) sudo zypper -q install -y "${avail[@]}" ;;
  esac
fi

# --------------------------------------------------------------------------- 2. fonts
if ! fc-list 2>/dev/null | grep -q "JetBrainsMono Nerd Font"; then
  log "Installing JetBrainsMono Nerd Font $NERDFONT_VER"
  fetch "https://github.com/ryanoasis/nerd-fonts/releases/download/$NERDFONT_VER/JetBrainsMono.tar.xz" "$NERDFONT_SHA256" "$TMP/jbm.tar.xz"
  mkdir -p "$D/fonts/RealHax-JetBrainsMono"; track "$D/fonts/RealHax-JetBrainsMono"
  tar -xJf "$TMP/jbm.tar.xz" -C "$D/fonts/RealHax-JetBrainsMono" --wildcards '*.ttf'
  fc-cache -f "$D/fonts" >/dev/null 2>&1 || true
fi

# --------------------------------------------------------------------------- 3. fastfetch
FF=fastfetch
if ! command -v fastfetch >/dev/null; then
  arch=$(uname -m); case "$arch" in x86_64) fa=amd64 ;; aarch64|arm64) fa=aarch64 ;; *) fa="" ;; esac
  if [[ -n $fa ]]; then
    log "Installing fastfetch $FASTFETCH_VER (pinned) to ~/.local/bin"
    sha_var="FASTFETCH_SHA256_$fa"
    fetch "https://github.com/fastfetch-cli/fastfetch/releases/download/$FASTFETCH_VER/fastfetch-linux-$fa.tar.gz" "${!sha_var}" "$TMP/ff.tgz"
    tar -xzf "$TMP/ff.tgz" -C "$TMP"
    install -Dm755 "$TMP/fastfetch-linux-$fa/usr/bin/fastfetch" "$HOME/.local/bin/fastfetch"
    track "$HOME/.local/bin/fastfetch"; FF="$HOME/.local/bin/fastfetch"
  else warn "no fastfetch build for $arch"; fi
fi

# --------------------------------------------------------------------------- 4. GTK + xfwm4 theme
if [[ ! -f "$HOME/.themes/RealHax-Dark/.realhax-$ORCHIS_TAG" ]]; then
  if command -v sassc >/dev/null; then
    log "Building RealHax-Dark theme (Orchis $ORCHIS_TAG, red, black)"
    fetch "https://github.com/vinceliuice/Orchis-theme/archive/refs/tags/$ORCHIS_TAG.tar.gz" "$ORCHIS_SHA256" "$TMP/orchis.tgz"
    tar -xzf "$TMP/orchis.tgz" -C "$TMP"
    mkdir -p "$TMP/themes"
    (cd "$TMP/Orchis-theme-$ORCHIS_TAG" && bash ./install.sh -d "$TMP/themes" -n RealHax -t red -c dark --tweaks black >/dev/null)
    mkdir -p "$HOME/.themes"
    for sfx in "" -hdpi -xhdpi; do
      src="$TMP/themes/RealHax-Red-Dark$sfx"; dst="$HOME/.themes/RealHax-Dark$sfx"
      [[ -d $src ]] || continue
      track "$dst"; rm -rf "$dst"; cp -a "$src" "$dst"
      [[ -f $dst/index.theme ]] && sed -i "s/RealHax-Red-Dark/RealHax-Dark/g; s/^Name=.*/Name=RealHax-Dark$sfx/" "$dst/index.theme"
    done
    touch "$HOME/.themes/RealHax-Dark/.realhax-$ORCHIS_TAG"
  else warn "sassc missing — cannot build GTK theme (install packages first)"; fi
fi

# --------------------------------------------------------------------------- 5. icons + logo
LOGO_SVG='<svg xmlns="http://www.w3.org/2000/svg" viewBox="-128 -128 256 256"><defs><linearGradient id="m" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff"/><stop offset=".5" stop-color="#b9c7de"/><stop offset="1" stop-color="#6d7d99"/></linearGradient></defs><g transform="scale(1.12)"><path d="M0,-100 L86.6,-50 L86.6,50 L0,100 L-86.6,50 L-86.6,-50 Z" fill="#0c1018"/><path d="M0,-100 L86.6,-50 L86.6,50 L0,100 L-86.6,50 L-86.6,-50 Z" fill="none" stroke="url(#m)" stroke-width="16" stroke-dasharray="88 12" stroke-dashoffset="44"/><path d="M0,-100 L86.6,-50 L86.6,50 L0,100 L-86.6,50 L-86.6,-50 Z" transform="scale(.74)" fill="none" stroke="url(#m)" stroke-width="7"/><path d="M-38,-26 L-6,2 L-38,30" fill="none" stroke="#fff" stroke-width="13" stroke-linecap="square"/><path d="M6,32 L44,32" stroke="#fff" stroke-width="13"/></g></svg>'
TERM_SVG='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect x="4" y="8" width="56" height="48" rx="7" fill="#111318" stroke="#ff2340" stroke-width="3"/><path d="M16,24 L26,32 L16,40" fill="none" stroke="#f2f3f5" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><path d="M30,42 H46" stroke="#f2f3f5" stroke-width="4" stroke-linecap="round"/></svg>'
FOLDER_SVG='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><defs><linearGradient id="f" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ff3a52"/><stop offset="1" stop-color="#d40f2b"/></linearGradient></defs><path d="M6,14 a4,4 0 0 1 4,-4 h14 l6,6 h24 a4,4 0 0 1 4,4 v4 H6 Z" fill="#a50c22"/><rect x="6" y="20" width="52" height="36" rx="4" fill="url(#f)"/><rect x="6" y="20" width="52" height="3" fill="#ff6b7d" opacity=".55"/></svg>'
HOME_SVG='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><defs><linearGradient id="h" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ff3a52"/><stop offset="1" stop-color="#d40f2b"/></linearGradient></defs><path d="M32,6 L60,30 L54,30 L54,58 L40,58 L40,40 L24,40 L24,58 L10,58 L10,30 L4,30 Z" fill="url(#h)"/><rect x="44" y="10" width="7" height="14" fill="#d40f2b"/></svg>'

IT="$D/icons/RealHax"; track "$IT"; rm -rf "$IT"; mkdir -p "$IT/scalable/places" "$IT/scalable/apps"
cat > "$IT/index.theme" <<EOF
[Icon Theme]
Name=RealHax
Comment=Papirus-Dark with realhax red folders
Inherits=Papirus-Dark,Papirus,Adwaita,hicolor
Directories=scalable/places,scalable/apps

[scalable/places]
Size=64
MinSize=16
MaxSize=512
Context=Places
Type=Scalable

[scalable/apps]
Size=64
MinSize=16
MaxSize=512
Context=Applications
Type=Scalable
EOF
for n in folder folder-open inode-directory folder-drag-accept user-desktop folder-documents folder-download \
         folder-music folder-pictures folder-videos folder-templates folder-publicshare folder-remote; do
  printf '%s\n' "$FOLDER_SVG" > "$IT/scalable/places/$n.svg"
done
printf '%s\n' "$HOME_SVG" > "$IT/scalable/places/user-home.svg"
printf '%s\n' "$LOGO_SVG" > "$IT/scalable/apps/realhax.svg"
printf '%s\n' "$TERM_SVG" > "$IT/scalable/apps/realhax-terminal.svg"
printf '%s\n' "$LOGO_SVG" | put "$D/icons/hicolor/scalable/apps/realhax.svg"
printf '%s\n' "$TERM_SVG" | put "$D/icons/hicolor/scalable/apps/realhax-terminal.svg"
gtk-update-icon-cache -q -f -t "$IT" 2>/dev/null || true

# --------------------------------------------------------------------------- 6. wallpaper
# Use assets/wallpaper.png beside this script (git clone) or fetch it from the
# repo (curl | bash). Either way it must match the pinned sha256.
WALL="$RH/wallpaper.png"
SELF_DIR=$(cd "$(dirname "${BASH_SOURCE[0]:-.}")" 2>/dev/null && pwd || echo .)
if [[ -f "$SELF_DIR/assets/wallpaper.png" ]]; then
  cp "$SELF_DIR/assets/wallpaper.png" "$TMP/wall.png"
  echo "$WALLPAPER_SHA256  $TMP/wall.png" | sha256sum -c --quiet - || { echo "assets/wallpaper.png checksum mismatch" >&2; exit 1; }
else
  log "Downloading wallpaper"
  fetch "$WALLPAPER_URL" "$WALLPAPER_SHA256" "$TMP/wall.png"
fi
install -Dm644 "$TMP/wall.png" "$WALL"

# --------------------------------------------------------------------------- 7. XFCE settings (xfconf XML)
# Write channels directly so the result is identical on first login. Stop xfconfd
# first so it can't overwrite our files from its in-memory cache.
pkill -u "$USER" -x xfconfd 2>/dev/null || true
X="$C/xfce4/xfconf/xfce-perchannel-xml"

put "$X/xsettings.xml" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="RealHax-Dark"/>
    <property name="IconThemeName" type="string" value="RealHax"/>
    <property name="EnableEventSounds" type="bool" value="false"/>
  </property>
  <property name="Gtk" type="empty">
    <property name="FontName" type="string" value="Inter 10"/>
    <property name="MonospaceFontName" type="string" value="JetBrainsMono Nerd Font 10"/>
    <property name="CursorThemeName" type="string" value="Adwaita"/>
  </property>
  <property name="Xft" type="empty">
    <property name="Antialias" type="int" value="1"/>
    <property name="Hinting" type="int" value="1"/>
    <property name="HintStyle" type="string" value="hintslight"/>
    <property name="RGBA" type="string" value="rgb"/>
  </property>
</channel>
EOF

put "$X/xfwm4.xml" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="theme" type="string" value="RealHax-Dark"/>
    <property name="title_font" type="string" value="Inter Medium 10"/>
    <property name="title_alignment" type="string" value="left"/>
    <property name="button_layout" type="string" value="O|HMC"/>
    <property name="use_compositing" type="bool" value="true"/>
    <property name="show_dock_shadow" type="bool" value="false"/>
    <property name="show_frame_shadow" type="bool" value="true"/>
    <property name="workspace_count" type="int" value="1"/>
  </property>
</channel>
EOF

put "$X/xfce4-desktop.xml" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
  <property name="desktop-icons" type="empty">
    <property name="style" type="int" value="2"/>
    <property name="icon-size" type="uint" value="44"/>
    <property name="tooltip-size" type="double" value="48"/>
    <property name="show-thumbnails" type="bool" value="false"/>
    <property name="file-icons" type="empty">
      <property name="show-home" type="bool" value="true"/>
      <property name="show-filesystem" type="bool" value="false"/>
      <property name="show-removable" type="bool" value="false"/>
      <property name="show-trash" type="bool" value="true"/>
    </property>
  </property>
  <property name="desktop-menu" type="empty">
    <property name="show" type="bool" value="true"/>
  </property>
</channel>
EOF

put "$X/xfce4-panel.xml" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="panels" type="array">
    <value type="int" value="1"/>
    <property name="dark-mode" type="bool" value="true"/>
    <property name="panel-1" type="empty">
      <property name="position" type="string" value="p=6;x=0;y=0"/>
      <property name="length" type="uint" value="100"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="size" type="uint" value="38"/>
      <property name="icon-size" type="uint" value="18"/>
      <property name="background-style" type="uint" value="1"/>
      <property name="background-rgba" type="array">
        <value type="double" value="0.039"/><value type="double" value="0.043"/>
        <value type="double" value="0.055"/><value type="double" value="0.92"/>
      </property>
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/><value type="int" value="2"/><value type="int" value="3"/>
        <value type="int" value="4"/><value type="int" value="5"/><value type="int" value="6"/>
        <value type="int" value="7"/><value type="int" value="8"/><value type="int" value="9"/>
      </property>
    </property>
  </property>
  <property name="plugins" type="empty">
    <property name="plugin-1" type="string" value="whiskermenu">
      <property name="button-title" type="string" value="Applications"/>
      <property name="button-icon" type="string" value="realhax"/>
      <property name="show-button-title" type="bool" value="true"/>
      <property name="show-button-icon" type="bool" value="true"/>
      <property name="button-single-row" type="bool" value="false"/>
      <property name="menu-opacity" type="int" value="96"/>
      <property name="view-mode" type="int" value="1"/>
    </property>
    <property name="plugin-2" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-3" type="string" value="systray">
      <property name="square-icons" type="bool" value="true"/>
      <property name="icon-size" type="int" value="18"/>
    </property>
    <property name="plugin-4" type="string" value="notification-plugin"/>
    <property name="plugin-5" type="string" value="pulseaudio">
      <property name="enable-keyboard-shortcuts" type="bool" value="true"/>
    </property>
    <property name="plugin-6" type="string" value="separator">
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-7" type="string" value="clock">
      <property name="mode" type="uint" value="2"/>
      <property name="digital-layout" type="uint" value="3"/>
      <property name="digital-time-format" type="string" value="%a %b %d  %H:%M"/>
      <property name="digital-time-font" type="string" value="Inter Medium 10"/>
    </property>
    <property name="plugin-8" type="string" value="separator">
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-9" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="realhax-power.desktop"/>
      </property>
    </property>
  </property>
</channel>
EOF

put "$C/xfce4/panel/launcher-9/realhax-power.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Power
Comment=Log out, restart or shut down
Exec=xfce4-session-logout
Icon=system-shutdown-symbolic
EOF

put "$C/xfce4/panel/whiskermenu-1.rc" <<'EOF'
button-title=Applications
button-icon=realhax
show-button-title=true
show-button-icon=true
menu-opacity=96
view-mode=1
EOF

# Alacritty as XFCE's preferred terminal
put "$D/xfce4/helpers/realhax-alacritty.desktop" <<'EOF'
[Desktop Entry]
NoDisplay=true
Version=1.0
Type=X-XFCE-Helper
X-XFCE-Category=TerminalEmulator
X-XFCE-Commands=alacritty
X-XFCE-CommandsWithParameter=alacritty -e "%s"
Icon=realhax-terminal
Name=Alacritty (realhax)
EOF
put "$C/xfce4/helpers.rc" <<'EOF'
TerminalEmulator=realhax-alacritty
EOF

# --------------------------------------------------------------------------- 8. terminal launcher + desktop
put "$D/applications/realhax-terminal.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Terminal
Comment=realhax terminal (Alacritty + fish)
Exec=alacritty
Icon=realhax-terminal
Terminal=false
Categories=System;TerminalEmulator;
StartupWMClass=Alacritty
EOF

DESK=$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")
[[ $DESK == "$HOME" ]] && DESK="$HOME/Desktop"
for f in Tools Recon Reports; do
  [[ -d "$DESK/$f" ]] || { mkdir -p "$DESK/$f"; echo "$DESK/$f" >> "$MANIFEST"; }
done
put "$DESK/Terminal.desktop" < "$D/applications/realhax-terminal.desktop"
chmod +x "$DESK/Terminal.desktop"
# XFCE 4.18 trusts a desktop launcher whose checksum is stored in gvfs metadata
gio set -t string "$DESK/Terminal.desktop" metadata::xfce-exe-checksum \
  "$(sha256sum "$DESK/Terminal.desktop" | cut -d' ' -f1)" 2>/dev/null || true

# --------------------------------------------------------------------------- 9. plank dock
put "$D/plank/themes/RealHax/dock.theme" <<'EOF'
[PlankTheme]
TopRoundness=10
BottomRoundness=10
LineWidth=1
OuterStrokeColor=255;;255;;255;;22
FillStartColor=14;;15;;19;;232
FillEndColor=10;;11;;14;;232
InnerStrokeColor=255;;255;;255;;8

[PlankDockTheme]
HorizPadding=12
TopPadding=10
BottomPadding=10
ItemPadding=16
IndicatorSize=3
IconShadowSize=0
UrgentBounceHeight=1.6666666666666667
LaunchBounceHeight=0.625
FadeOpacity=1
ClickTime=300
UrgentBounceTime=600
LaunchBounceTime=600
ActiveTime=300
SlideTime=300
FadeTime=250
HideTime=150
GlowSize=30
GlowTime=10000
GlowPulseTime=2000
UrgentHueShift=150
ItemMoveTime=450
CascadeHide=true
EOF

find_desktop() { # first existing .desktop among candidates
  local dirs=("$D/applications" /usr/share/applications /usr/local/share/applications
              /var/lib/snapd/desktop/applications /var/lib/flatpak/exports/share/applications
              "$D/flatpak/exports/share/applications")
  for n in "$@"; do for d in "${dirs[@]}"; do [[ -f "$d/$n" ]] && { echo "$d/$n"; return; }; done; done
}
L="$C/plank/dock1/launchers"; track "$L"; rm -rf "$L"; mkdir -p "$L"
items=()
add_item() { # name candidates...
  local name=$1; shift; local f; f=$(find_desktop "$@") || true
  [[ -z $f ]] && return 0
  printf '[PlankDockItemPreferences]\nLauncher=file://%s\n' "$f" > "$L/$name.dockitem"; items+=("'$name.dockitem'")
}
add_item terminal  realhax-terminal.desktop
add_item files     thunar.desktop org.xfce.thunar.desktop Thunar.desktop
add_item firefox   firefox.desktop firefox_firefox.desktop firefox-esr.desktop org.mozilla.firefox.desktop
add_item code      code.desktop code_code.desktop com.visualstudio.code.desktop code-oss.desktop
add_item editor    org.xfce.mousepad.desktop mousepad.desktop
add_item wireshark org.wireshark.Wireshark.desktop wireshark.desktop
add_item apps      xfce4-appfinder.desktop org.xfce.appfinder.desktop
put "$RH/plank.dconf" <<EOF
[/]
theme='RealHax'
position='bottom'
alignment='center'
icon-size=42
zoom-enabled=false
hide-mode='none'
show-dock-item=false
lock-items=false
pressure-reveal=false
dock-items=[$(IFS=,; echo "${items[*]}")]
EOF
plank_apply() { dconf write /net/launchpad/plank/enabled-docks "['dock1']" && dconf load /net/launchpad/plank/docks/dock1/ < "$RH/plank.dconf"; }
plank_apply 2>/dev/null || warn "dconf unavailable now; dock settings will apply at first XFCE login"

# --------------------------------------------------------------------------- 10. conky widgets
put "$C/conky/realhax-system.conf" <<'EOF'
-- realhax: System widget
local function sh(c) local p = io.popen(c); local r = p:read("*l"); p:close(); return r end
local IF = sh("ip route show default 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i==\"dev\"){print $(i+1); exit}}'") or "eth0"
conky.config = {
  alignment = 'top_right', gap_x = 18, gap_y = 58,
  minimum_width = 236, maximum_width = 236,
  own_window = true, own_window_type = 'desktop', own_window_class = 'Conky',
  own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
  own_window_argb_visual = true, own_window_argb_value = 215,
  own_window_transparent = false, own_window_colour = '0e0f13',
  border_inner_margin = 16, double_buffer = true, update_interval = 1.5,
  use_xft = true, font = 'Inter:size=9', draw_shades = false, draw_outline = false,
  draw_borders = false, draw_graph_borders = false,
  default_color = 'e6e8ec', color0 = 'ff2340', color1 = 'e6e8ec', color2 = '9aa0aa', color3 = '2a2c33',
}
conky.text = [[
${font JetBrainsMono Nerd Font:size=10}@@F192@@${font Inter:bold:size=10}  System${font}
${voffset 8}${font Inter:bold:size=10}CPU${alignr}${cpu cpu0}%${font}
${color0}${cpugraph cpu0 24,236 ff2340 ff2340 -t}${color}
${voffset 4}${font Inter:bold:size=10}Memory${alignr}${font Inter:size=9}${mem} / ${memmax} (${memperc}%)${font}
${color0}${membar 7,236}${color}
${voffset 4}${font Inter:bold:size=10}Disk${alignr}${fs_used_perc /}%${font}
${color0}${fs_bar 7,140 /}${color}${alignr}${fs_free /} free
${voffset 4}${font Inter:bold:size=10}Network${font}
${color0}${font JetBrainsMono Nerd Font:size=9}@@F063@@${font}${color} ${downspeed ]] .. IF .. [[}/s${alignr}${color0}${font JetBrainsMono Nerd Font:size=9}@@F062@@${font}${color} ${upspeed ]] .. IF .. [[}/s
${color0}${downspeedgraph ]] .. IF .. [[ 22,236 ff2340 ff2340 -t}${color}
]]
EOF

put "$C/conky/realhax-labinfo.conf" <<'EOF'
-- realhax: Lab Info widget. "Attacker (connected)" turns green when a lab VPN (tun0) is up.
local function sh(c) local p = io.popen(c); local r = p:read("*l"); p:close(); return r end
local IF = sh("ip route show default 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i==\"dev\"){print $(i+1); exit}}'") or "eth0"
local OS = sh(". /etc/os-release 2>/dev/null; echo \"$NAME ($(hostname))\"") or "Linux"
conky.config = {
  alignment = 'top_right', gap_x = 18, gap_y = 418,
  minimum_width = 236, maximum_width = 236,
  own_window = true, own_window_type = 'desktop', own_window_class = 'Conky',
  own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
  own_window_argb_visual = true, own_window_argb_value = 215,
  own_window_transparent = false, own_window_colour = '0e0f13',
  border_inner_margin = 16, double_buffer = true, update_interval = 3,
  use_xft = true, font = 'Inter:size=9', draw_shades = false, draw_outline = false,
  draw_borders = false, default_color = 'e6e8ec', color0 = 'ff2340', color2 = '9aa0aa', color4 = '22c55e',
}
conky.text = [[
${font JetBrainsMono Nerd Font:size=10}@@F192@@${font Inter:bold:size=10}  Lab Info${font}
${voffset 10}${if_up tun0}${color4}●${color}  Attacker ${color4}(connected)${color}${else}${color2}●${color}  Attacker ${color2}(offline)${color}${endif}
${voffset 8}IP Address${alignr}${if_up tun0}${addr tun0}${else}${addr ]] .. IF .. [[}${endif}
OS${alignr}]] .. OS .. [[

Uptime${alignr}${uptime_short}
${voffset 8}${color2}${hr 1}${color}
${alignc}${font JetBrainsMono Nerd Font:size=10}@@F02D@@${font}  Open Lab Guide
]]
EOF

# --------------------------------------------------------------------------- 11. session init + autostart (XFCE only)
put "$HOME/.local/bin/realhax-session-init" <<EOF
#!/bin/sh
# realhax: runs at every XFCE login. Points every monitor/workspace at the
# wallpaper (monitor names differ per machine) and applies dock settings once.
WP="$WALL"
xset_() { xfconf-query -c xfce4-desktop -p "\$1" -s "\$3" 2>/dev/null || xfconf-query -c xfce4-desktop -p "\$1" -n -t "\$2" -s "\$3"; }
for m in \$(xrandr --listmonitors 2>/dev/null | awk 'NR>1{print \$NF}'); do
  for ws in 0 1 2 3; do
    b=/backdrop/screen0/monitor\$m/workspace\$ws
    xset_ \$b/last-image string "\$WP"
    xset_ \$b/image-style int 5
    xset_ \$b/color-style int 0
  done
done
for p in \$(xfconf-query -c xfce4-desktop -l | grep '/last-image\$'); do xfconf-query -c xfce4-desktop -p "\$p" -s "\$WP"; done
if [ ! -f "$RH/.plank-applied" ]; then
  dconf write /net/launchpad/plank/enabled-docks "['dock1']" && dconf load /net/launchpad/plank/docks/dock1/ < "$RH/plank.dconf" && touch "$RH/.plank-applied"
fi
EOF
chmod +x "$HOME/.local/bin/realhax-session-init"

autostart() { # name exec
  put "$C/autostart/realhax-$1.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=realhax $1
Exec=$2
OnlyShowIn=XFCE;
X-GNOME-Autostart-enabled=true
NoDisplay=true
EOF
}
autostart init   "$HOME/.local/bin/realhax-session-init"
autostart plank  "sh -c 'sleep 2; exec plank'"
autostart conky1 "sh -c 'sleep 4; exec conky -q -c $C/conky/realhax-system.conf'"
autostart conky2 "sh -c 'sleep 4; exec conky -q -c $C/conky/realhax-labinfo.conf'"

# --------------------------------------------------------------------------- 12. alacritty
# The shell key moved from [shell] (<= 0.13) to [terminal.shell] (0.14+); each
# version warns about the other. Default to the new name if we can't tell.
ALAC_SHELL="terminal.shell"
if alac_v=$(alacritty --version 2>/dev/null) && [[ $alac_v =~ ([0-9]+)\.([0-9]+) ]] \
   && (( BASH_REMATCH[1] == 0 && BASH_REMATCH[2] < 14 )); then
  ALAC_SHELL="shell"
fi
put "$C/alacritty/alacritty.toml" <<EOF
# realhax terminal
[env]
TERM = "xterm-256color"
STARSHIP_CONFIG = "$C/realhax/starship.toml"

[$ALAC_SHELL]
program = "/usr/bin/env"
args = ["fish", "-l"]

[window]
dimensions = { columns = 92, lines = 26 }
padding = { x = 18, y = 14 }
opacity = 0.94
dynamic_title = true
decorations = "Full"

[font]
size = 11.5
normal = { family = "JetBrainsMono Nerd Font", style = "Regular" }
bold = { family = "JetBrainsMono Nerd Font", style = "Bold" }
italic = { family = "JetBrainsMono Nerd Font", style = "Italic" }

[cursor]
style = { shape = "Block", blinking = "On" }

[colors.primary]
background = "$BG"
foreground = "$FG"

[colors.cursor]
text = "$BG"
cursor = "#e8e8e8"

[colors.selection]
text = "#ffffff"
background = "#5a1420"

[colors.normal]
black = "#1a1c22"
red = "$RED"
green = "#22c55e"
yellow = "#f5a524"
blue = "#3b82f6"
magenta = "#f0405a"
cyan = "#5ec4d8"
white = "#c8ccd4"

[colors.bright]
black = "#3a3f48"
red = "#ff5c70"
green = "#4ade80"
yellow = "#fbbf24"
blue = "#60a5fa"
magenta = "#f5a0aa"
cyan = "#7dd3fc"
white = "#ffffff"
EOF

# --------------------------------------------------------------------------- 13. shell prompt
# user@host  [>~>]  the path sits in a blue tag with a notched left edge (a
# powerline arrow drawn in the terminal background colour) and an arrow tip.
put "$C/realhax/starship.toml" <<'EOF'
# realhax prompt (used inside the realhax terminal when starship is installed)
add_newline = true
format = "$username$hostname $directory\n$character"

[username]
show_always = true
style_user = "bold #ff2340"
style_root = "bold #ff2340"
format = "[$user]($style)"

[hostname]
ssh_only = false
style = "#d0d4dc"
format = "[@$hostname]($style)"

[directory]
style = "bg:#1f4fa8 fg:#ffffff"
format = "[@@E0B0@@](fg:#0b0c10 bg:#1f4fa8)[ $path ]($style)[@@E0B0@@](fg:#1f4fa8)"
truncation_length = 3
truncate_to_repo = false
home_symbol = "~"

[character]
success_symbol = "[❯](bold #ff2340)"
error_symbol = "[❯](bold #ffb000)"
EOF

put "$C/fish/functions/fish_prompt.fish" <<'EOF'
# realhax prompt (fallback when starship is not installed)
function fish_prompt
    set -l last $status
    echo
    set_color --bold ff2340; printf '%s' $USER
    set_color normal; set_color d0d4dc; printf '@%s ' (prompt_hostname)
    set_color -b 1f4fa8 0b0c10; printf '@@E0B0@@'
    set_color -b 1f4fa8 ffffff; printf ' %s ' (prompt_pwd)
    set_color normal; set_color 1f4fa8; printf '@@E0B0@@'
    set_color normal; echo
    if test $last -eq 0; set_color --bold ff2340; else; set_color --bold ffb000; end
    printf '❯ '; set_color normal
end
EOF
put "$C/fish/functions/fish_title.fish" <<'EOF'
# window title: user@host: ~
function fish_title
    printf '%s@%s: %s' $USER (prompt_hostname) (prompt_pwd)
end
EOF
put "$C/fish/conf.d/realhax.fish" <<EOF
# realhax shell tweaks
set -g fish_greeting ''
set -g fish_color_command 79b8ff
set -g fish_color_param d6d9df
set -g fish_color_error ff2340
set -g fish_color_autosuggestion 536278
fish_add_path -g $HOME/.local/bin
# 'neofetch' shows the realhax fastfetch card if real neofetch is absent
if not command -sq neofetch; and command -sq fastfetch
    function neofetch; fastfetch \$argv; end
end
EOF

