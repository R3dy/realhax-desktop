BO+PEydTFioufVkQyXWFgnlxtzHDZTBdS1qtTCyzqHfxN/YcNuL0zEnRzxSl8ezvnhV6RqnnVt7EOMvUEJBUIOgH2OoAsvPdNYIv
vOJD74Auf3XXt/XQAv66gzrrcMtG4VDJhc3KNZpEh2E4DZ6nHzzb5NGDgeY5i3qm5m6Qw8ySgiCdPs8lgddQvLTDsTpo95qbzHxI
1EeGKzEr8l0gvz70lCnc7Oags5DCekhC/kcf2N4n7nvb2R75xd/LIdDGqfSteltOcWH0ckVwcGGuiMaJ8cELFROtvPMUTxxw780d
+DwAhe/teeTHiT/acV0AxqoFWpe49803Zqt1zoYdILnaO5cG1JeVpQSHLBe7B5ZDkrUyGnUHTeZC7wN6m0OvreYrEz3Ksw7Ojzva
CX8CV5ffebyGG1y7UbNSv/vLsELocc2n/pjg5T75f/TFMfXgTpgm+Z+B7fhd25yFh9nJ9pBCor176k23qY0GOjHrltWdNo+XNiyD
LfjLi/z/fPL97Z/f3/5O71/v3xy9w8ZNBjb0hS4cN6frmiG/1uENvkE1o9v8AZ/wk3/o5uH9fAf/+v3722/estTxUbA9PBaU4F9n
Fakv6PsXUuMrrf6m/36uQvwWjvobaWI/g8K+W2652Uy3h76wMv8Cx2sTargnAAA=
'
# <<< REALHAX-LOGO
printf '%s' "$LOGO_ANS_B64" | base64 -d | gzip -dc | put "$C/fastfetch/realhax-logo.ans"
# Host: DMI product name, else "Virtual Machine" (VMs) or the hostname.
FF_HOST='{ "type": "command", "key": "\uf108 Host:", "keyColor": "__KC__", "text": "p=$(cat /sys/class/dmi/id/product_name 2>/dev/null); case $p in \"\"|*\"To be filled\"*|*\"System Product Name\"*|*\"Default string\"*|*\"Not Specified\"*|*\"Not Applicable\"*) if systemd-detect-virt -vq 2>/dev/null; then echo Virtual Machine; else hostname 2>/dev/null || cat /etc/hostname; fi ;; *) echo \"$p\" ;; esac" },'
FF_SEP='{ "type": "separator", "string": "-", "outputColor": "38;2;255;35;64" },'
FF_TITLE='{ "type": "title", "color": { "user": "1;38;2;255;35;64", "at": "38;2;214;217;223", "host": "1;38;2;255;35;64" } },'
if (( LAB_PERSONA )); then   # cosmetic: card only, real user/hostname untouched
  FF_TITLE='{ "type": "custom", "format": "\u001b[1;38;2;255;35;64mstudent\u001b[0;38;2;214;217;223m@\u001b[1;38;2;255;35;64mrealhax\u001b[0m" },'
  FF_HOST='{ "type": "custom", "key": "\uf108 Host:", "keyColor": "__KC__", "format": "Training VM" },'
  FF_SEP='{ "type": "separator", "string": "-", "times": 15, "outputColor": "38;2;255;35;64" },'
fi
ff_cfg=$(cat <<'EOF'
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "__FF_LOGO__",
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": " ",
    "color": { "keys": "__KC__", "title": "38;2;255;35;64", "separator": "38;2;255;35;64", "output": "38;2;200;210;226" },
    "key": { "width": 13 }
  },
  "modules": [
    __FF_TITLE__
    __FF_SEP__
    { "type": "os",       "key": "\uf17c OS:",       "keyColor": "__KC__", "format": "realhax Linux (XFCE)" },
    __FF_HOST__
    { "type": "kernel",   "key": "\uf490 Kernel:",   "keyColor": "__KC__" },
    { "type": "uptime",   "key": "\uf017 Uptime:",   "keyColor": "__KC__" },
    { "type": "packages", "key": "\uf187 Packages:", "keyColor": "__KC__" },
    { "type": "shell",    "key": "\uf120 Shell:",    "keyColor": "__KC__" },
    { "type": "de",       "key": "\uf26c DE:",       "keyColor": "__KC__" },
    { "type": "wm",       "key": "\uf2d2 WM:",       "keyColor": "__KC__" },
    { "type": "theme",    "key": "\uf53f Theme:",    "keyColor": "__KC__" },
    { "type": "icons",    "key": "\uf03e Icons:",    "keyColor": "__KC__" },
    { "type": "terminal", "key": "\uf489 Terminal:", "keyColor": "__KC__" },
    { "type": "cpu",      "key": "\uf2db CPU:",      "keyColor": "__KC__" },
    { "type": "memory",   "key": "\uf233 Memory:",   "keyColor": "__KC__" },
    "break",
    { "type": "custom", "format": "\u001b[48;2;230;16;42m    \u001b[48;2;240;64;90m    \u001b[48;2;245;160;170m    \u001b[48;2;58;63;72m    \u001b[48;2;122;131;148m    \u001b[48;2;200;204;212m    \u001b[0m" }
  ]
}
EOF
)
ff_cfg=${ff_cfg//__FF_TITLE__/"$FF_TITLE"}
ff_cfg=${ff_cfg//__FF_HOST__/"$FF_HOST"}
ff_cfg=${ff_cfg//__FF_SEP__/"$FF_SEP"}
ff_cfg=${ff_cfg//__FF_LOGO__/"$C/fastfetch/realhax-logo.ans"}
ff_cfg=${ff_cfg//__KC__/"38;2;235;238;242"}
printf '%s\n' "$ff_cfg" | put "$C/fastfetch/config.jsonc"

# --------------------------------------------------------------------------- 15. default session
if (( ! KEEP_SESSION && ! SKIP_PKGS )); then
  AS="/var/lib/AccountsService/users/$USER"
  if [[ -d /var/lib/AccountsService/users ]] && [[ -f /usr/share/xsessions/xfce.desktop ]]; then
    log "Making XFCE your default login session"
    for m in SetXSession SetSession; do
      gdbus call --system --dest org.freedesktop.Accounts --object-path "/org/freedesktop/Accounts/User$(id -u)" \
        --method "org.freedesktop.Accounts.User.$m" xfce >/dev/null 2>&1 || true
    done
    { if sudo test -f "$AS"; then sudo cat "$AS"; else echo "[User]"; fi; } \
      | sed '/^Session=/d; /^XSession=/d' | sed '/^\[User\]/a Session=xfce\nXSession=xfce' > "$TMP/as"
    put "$AS" < "$TMP/as"
  fi
fi

# --------------------------------------------------------------------------- 16. live reload (only inside XFCE)
if [[ "${XDG_CURRENT_DESKTOP:-}" == *XFCE* ]]; then
  log "Reloading XFCE components"
  (xfsettingsd --replace >/dev/null 2>&1 &)
  (xfwm4 --replace >/dev/null 2>&1 &)
  xfce4-panel -r >/dev/null 2>&1 || true
  "$HOME/.local/bin/realhax-session-init" >/dev/null 2>&1 || true
  xfdesktop --reload >/dev/null 2>&1 || true
  pkill -u "$USER" -x plank 2>/dev/null || true; (plank >/dev/null 2>&1 &)
  pkill -u "$USER" -x conky 2>/dev/null || true
  (conky -q -d -c "$C/conky/realhax-system.conf"; conky -q -d -c "$C/conky/realhax-labinfo.conf") >/dev/null 2>&1 || true
  log "realhax desktop $RH_VERSION applied."
else
  log "realhax desktop $RH_VERSION installed. Log out and choose the 'Xfce Session' at the login screen."
fi
log "Originals backed up in $BACKUP — undo with: bash install.sh --restore"
